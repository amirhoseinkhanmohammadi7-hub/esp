```php
# Environment specific
.env
.env.local
.env.*

# Logs
*.log

# Cache and temporary files
.cache/
tmp/
temp/

# Composer dependencies (if PHP project uses Composer)
vendor/

# Build artifacts
dist/
build/
target/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
.coverage

# Python cache (if mixed environment)
__pycache__/
*.pyc
*.pyo
*.pyd
```